{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rtldatasets-com-sandbox",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/__private/*", "/purchase-success", "/purchase-success/*"]
  },
  "d1_databases": [
    {
      "binding": "ORDERS",
      "database_name": "rtldatasets-orders-sandbox",
      "database_id": "e01b0cc8-70f6-4691-8501-8bbb78270c41"
    }
  ],
  "ratelimits": [
    {
      "name": "CHECKOUT_RATE_LIMITER",
      "namespace_id": "240801002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "STORE_LIVE": "false",
    "SITE_URL": "https://rtldatasets-com-sandbox.yousefsalem00.workers.dev",
    "STRIPE_MODE": "test",
    "STRIPE_AUTOMATIC_TAX": "false"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
