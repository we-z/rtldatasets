# Checkout stays disabled unless this is explicitly true.
STORE_LIVE=false
SITE_URL=https://www.rtltasks.com

# Stripe server credentials and the fixed one-time $1,000 Price.
STRIPE_SECRET_KEY=
STRIPE_MODE=test
STRIPE_WEBHOOK_SECRET=
STRIPE_SAMPLE_PRICE_ID=
STRIPE_AUTOMATIC_TAX=false

# At least 32 random bytes, used to sign checkout and access tokens.
ENTITLEMENT_SIGNING_SECRET=

# Must match lib/product.js exactly (see PRODUCT.artifactAssetPath etc).
SAMPLE_ASSET_PATH=
SAMPLE_ARCHIVE_SHA256=
SAMPLE_ARCHIVE_BYTES=

# Auto-provisioned by `vercel blob create-store <name> --access private`.
# The protected archive itself is uploaded via `npm run upload:artifact`.
BLOB_READ_WRITE_TOKEN=

# Postgres (e.g. a Neon database added via the Vercel Marketplace).
DATABASE_URL=

# Upstash Redis (added via the Vercel Marketplace), used for checkout rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
