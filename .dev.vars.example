# Checkout stays disabled unless this is explicitly true.
STORE_LIVE=false
SITE_URL=https://www.rtldatasets.com

# Stripe server credentials and the fixed one-time $1,000 Price.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SAMPLE_PRICE_ID=
STRIPE_AUTOMATIC_TAX=false

# At least 32 random bytes, used to sign checkout, redemption, and access tokens.
ENTITLEMENT_SIGNING_SECRET=

# The paid archive stays in a private R2 bucket and is streamed by the Worker.
SAMPLE_R2_KEY=
SAMPLE_ARCHIVE_SHA256=
SAMPLE_ARCHIVE_BYTES=

# Cloudflare Email Service sender. The domain must be onboarded for sending.
FULFILLMENT_FROM_EMAIL=delivery@rtldatasets.com
