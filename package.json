{
  "name": "rtltasks.com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vercel dev",
    "dev:cloudflare": "wrangler dev",
    "deploy:cloudflare": "npm test && npm run verify:worker-assets && wrangler deploy",
    "deploy:sandbox": "npm test && wrangler deploy --config wrangler.sandbox.jsonc",
    "deploy:staging": "wrangler deploy --config wrangler.staging.jsonc",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply rtldatasets-orders --local",
    "db:migrate:remote": "wrangler d1 migrations apply rtldatasets-orders --remote",
    "db:migrate:sandbox": "wrangler d1 migrations apply rtldatasets-orders-sandbox --remote --config wrangler.sandbox.jsonc",
    "db:migrate:pg": "node scripts/db-migrate.mjs",
    "migrate:orders:d1-to-pg": "node scripts/migrate-orders-d1-to-pg.mjs",
    "upload:artifact": "node scripts/upload-vercel-artifact.mjs",
    "package:sample": "node scripts/package-sample.mjs",
    "prepare:production-assets": "node scripts/prepare-worker-assets.mjs",
    "verify:worker-assets": "node scripts/verify-worker-assets.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.2",
    "@vercel/blob": "2.7.0",
    "pg": "8.23.0",
    "stripe": "22.4.0"
  },
  "devDependencies": {
    "tar": "7.5.22",
    "vercel": "58.9.0",
    "wrangler": "4.118.0"
  }
}
