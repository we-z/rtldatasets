{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rtldatasets-com",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "www.rtldatasets.com",
      "custom_domain": true
    },
    {
      "pattern": "www.rtltasks.com",
      "custom_domain": true
    },
    {
      "pattern": "rtltasks.com",
      "custom_domain": true
    },
    {
      "pattern": "puul.ai/*",
      "zone_name": "puul.ai"
    },
    {
      "pattern": "www.puul.ai/*",
      "zone_name": "puul.ai"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "vars": {
    "SITE_URL": "https://www.rtltasks.com"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
