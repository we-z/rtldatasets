{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rtldatasets-com",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "www.rtldatasets.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./.worker-assets",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/__private/*", "/purchase-success", "/purchase-success/*"]
  },
  "d1_databases": [
    {
      "binding": "ORDERS",
      "database_name": "rtldatasets-orders",
      "database_id": "5f8f3805-b0bd-4a41-be68-d7fda360d7a4"
    }
  ],
  "ratelimits": [
    {
      "name": "CHECKOUT_RATE_LIMITER",
      "namespace_id": "240801001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "STORE_LIVE": "true",
    "SITE_URL": "https://www.rtldatasets.com",
    "STRIPE_MODE": "live",
    "STRIPE_AUTOMATIC_TAX": "false",
    "SAMPLE_ASSET_PATH": "/__private/artifacts/soc-dv-rlvr-diagnostic-sample-5-task/v1.0.0/sha256/ddecf9fc5e0057d4a884b2537ea7e2c973235714fa731e9b68e5dbc8432b1dfc/soc-dv-rlvr-diagnostic-sample-5-task-v1.0.0.tar.gz",
    "SAMPLE_ARCHIVE_SHA256": "ddecf9fc5e0057d4a884b2537ea7e2c973235714fa731e9b68e5dbc8432b1dfc",
    "SAMPLE_ARCHIVE_BYTES": "69768"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
