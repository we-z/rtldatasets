{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rtldatasets-com",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "www.rtldatasets.com",
      "custom_domain": true
    },
    {
      "pattern": "www.rtltasks.com",
      "custom_domain": true
    },
    {
      "pattern": "puul.ai/*",
      "zone_name": "puul.ai"
    },
    {
      "pattern": "www.puul.ai/*",
      "zone_name": "puul.ai"
    }
  ],
  "assets": {
    "directory": "./.worker-assets",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "ORDERS",
      "database_name": "rtldatasets-orders",
      "database_id": "5f8f3805-b0bd-4a41-be68-d7fda360d7a4"
    }
  ],
  "ratelimits": [
    {
      "name": "CHECKOUT_RATE_LIMITER",
      "namespace_id": "240801001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "STORE_LIVE": "true",
    "SITE_URL": "https://www.rtltasks.com",
    "STRIPE_MODE": "live",
    "STRIPE_AUTOMATIC_TAX": "false",
    "SAMPLE_ASSET_PATH": "/__private/artifacts/soc-dv-rlvr-diagnostic-sample-5-task/v1.0.2/sha256/24eceb7389d767099370afadbdebe8bb74a6744241f4e3957635d53ce6dbb904/soc-dv-gpt-5.3-codex-spark-customer-package-v1.0.2.zip",
    "SAMPLE_ARCHIVE_SHA256": "24eceb7389d767099370afadbdebe8bb74a6744241f4e3957635d53ce6dbb904",
    "SAMPLE_ARCHIVE_BYTES": "164691"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
